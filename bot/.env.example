# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token
STAFF_ROLE_ID=your_staff_role_id
# Optional: set to your test server's ID for instant (non-global) slash command sync during development
GUILD_ID=your_test_server_id

# --- Database (Railway injects this automatically when you add a PostgreSQL plugin) ---
DATABASE_URL=your_postgresql_connection_string
# --- Litecoin / BlockCypher ---
# Litecoin mainnet is enabled for this deployment.
LTC_NETWORK=main
# Free tier works for development; get a token at https://accounts.blockcypher.com/
LTC_API_KEY=your_blockcypher_token
CONFIRMATIONS_REQUIRED=2

# Fernet key used to encrypt the escrow's own per-trade wallet private keys at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=your_fernet_encryption_key

# --- Webhook server (for BlockCypher payment push notifications) ---
# Railway sets PORT automatically; only set WEBHOOK_PORT for local dev.
WEBHOOK_PORT=8080
# Public HTTPS URL BlockCypher can reach, e.g. https://your-app.up.railway.app
# Leave blank to rely solely on the polling fallback (works fine, just slower).
WEBHOOK_PUBLIC_BASE_URL=

# --- Trade behaviour ---
TRADE_EXPIRATION_MINUTES=60
POLL_INTERVAL_SECONDS=30
# Reserved from the escrow deposit for the Litecoin miner fee.
PAYOUT_FEE_RESERVE_SATOSHIS=100000

# Required to enable the real-money mainnet path.
ALLOW_MAINNET_I_HAVE_TESTED_THOROUGHLY=true
